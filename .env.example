# Salin file ini menjadi .env.local lalu isi dengan nilai project Supabase Anda.
# Nilai keduanya bukan rahasia (anon key), tetapi tetap tidak di-commit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opsional: dipakai oleh scripts/seed-demo.mjs (jangan pernah terekspos ke klien).
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: API Key Google Gemini untuk analisis AI sungguhan di /cek-pesan.
# Tanpa kunci ini, /cek-pesan otomatis memakai mesin aturan lokal.
GEMINI_API_KEY=
